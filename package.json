{
  "name": "inverse-corner-box",
  "version": "1.1.1",
  "description": "Smooth inverse (concave) corner cards and multi-corner containers with spring morph animations for React and Next.js",
  "keywords": [
    "react",
    "nextjs",
    "ui",
    "corner",
    "inverse-corner",
    "concave",
    "notch",
    "card",
    "component",
    "tailwind",
    "design",
    "svg",
    "spring",
    "morph"
  ],
  "author": "rossek22 (https://github.com/rossek22)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rossek22/inverse-corner-box.git"
  },
  "bugs": {
    "url": "https://github.com/rossek22/inverse-corner-box/issues"
  },
  "homepage": "https://github.com/rossek22/inverse-corner-box#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.8.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
